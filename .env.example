# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
DATABASE_URL=
DIRECT_URL=
SETUP_SECRET=
CRON_SECRET=

# Creem Billing (legacy / fallback when BILLING_PROVIDER=creem)
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_PRODUCT_SUBSCRIPTION=
CREEM_PRODUCT_CREDITS_SMALL=
CREEM_PRODUCT_CREDITS_MEDIUM=
CREEM_PRODUCT_CREDITS_LARGE=
CREEM_CREDITS_SUBSCRIPTION=2000
CREEM_CREDITS_SMALL=500
CREEM_CREDITS_MEDIUM=2000
CREEM_CREDITS_LARGE=5000

# Gumroad Billing (primary merchant of record)
# Generate token: Gumroad → Settings → Advanced → Applications → access token
BILLING_PROVIDER=gumroad
GUMROAD_ACCESS_TOKEN=
GUMROAD_WEBHOOK_SECRET=
GUMROAD_PRODUCT_SUBSCRIPTION=
GUMROAD_PRODUCT_CREDITS_SMALL=
GUMROAD_PRODUCT_CREDITS_MEDIUM=
GUMROAD_PRODUCT_CREDITS_LARGE=
GUMROAD_PERMALINK_SUBSCRIPTION=
GUMROAD_PERMALINK_CREDITS_SMALL=
GUMROAD_PERMALINK_CREDITS_MEDIUM=
GUMROAD_PERMALINK_CREDITS_LARGE=
# Soft guard: comma-separated emails that must not receive credit grants (self-tests)
BILLING_SELF_TEST_EMAILS=
# Optional seller email — purchases matching this skip grants
GUMROAD_SELLER_EMAIL=

FREE_CREDITS=200
# Daily login top-up when balance is under the cap (defaults: 30 / 300)
DAILY_LOGIN_CREDITS=30
DAILY_LOGIN_BALANCE_CAP=300
CREDIT_EXPIRY_DAYS=90
MIN_JOB_CREDITS=10
NEXT_PUBLIC_APP_URL=https://memories-recap-one.vercel.app

# Feature flags (optional)
SHARE_AUTO=false
# When true: account invite UI + GET /api/referrals (?ref=userId). Credit rewards not wired yet.
REFERRALS_ENABLED=false
MUSIC_PAID_ENABLED=false
MARKETING_EXPERIMENTS=false
WAITLIST_ENABLED=false

# Vision AI (optional but recommended) — first available wins: Gemini → Groq → OpenAI
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
AI_GATEWAY_API_KEY=

# Email (optional) — Resend for welcome + "recap ready" messages
RESEND_API_KEY=
EMAIL_FROM=Memories Recap <onboarding@resend.dev>

# Ads (optional)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Large video uploads (Vercel Blob) — required for files > ~45 MB
# Created via: vercel blob create-store memories-uploads --access private
BLOB_READ_WRITE_TOKEN=
